<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Version>0.2.2.0</Version>
        <Description>在 FF14 小队列表上直接显示 oopz 语音房间里谁在说话，改编自 WhosTalking。</Description>
        <PackageProjectUrl>https://codeberg.org/keysmashes/WhosTalking</PackageProjectUrl>
        <AssemblyName>OopzTalking</AssemblyName>
        <RootNamespace>OopzTalking</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2022.3.1"/>
        <Content Include="images\previewImage.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="images\icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="images\mute.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="images\deafen.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>